# Copy to .env for local development.
# In production this is set in the Amplify console instead:
#   App settings > Environment variables > VITE_API_BASE_URL
#
# Value = the ApiEndpoint output of the h2s-backend stack, e.g.
#   https://<api-id>.execute-api.<region>.amazonaws.com/Prod
VITE_API_BASE_URL=
